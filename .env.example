# Copy to .env and fill in values — never commit .env

# ── Database ──────────────────────────────────────────────────────────────────
# Full Postgres connection string
DATABASE_URL=postgresql://anime_tracker:changeme@localhost:5432/anime_tracker

# ── AniList ───────────────────────────────────────────────────────────────────
# Your AniList username (not email) — used to fetch your library
ANILIST_USERNAME=

# OAuth access token — needed for write operations (rating, status, progress)
# See README for how to obtain this via the AniList OAuth PIN flow
ANILIST_TOKEN=

# ── Crunchyroll (optional) ────────────────────────────────────────────────────
# Session cookie value — see crunchyexporter-cli docs for extraction steps
# Long-lived but will eventually expire; update when CR sync starts failing
CRUNCHYROLL_ETP_RT=

# ── Telegram notifications (optional) ────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal chat ID — get it from @userinfobot
TELEGRAM_CHAT_ID=

# ── Auth (multi-user) ────────────────────────────────────────────────────────
# Random secret used to sign session cookies. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random one is generated at startup — fine for local dev, but sessions
# won't survive a restart. Set a stable value for any real deployment.
SESSION_SECRET_KEY=

# Google OAuth client — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth client — create at https://discord.com/developers/applications
# Redirect URI: https://your-domain/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── CI/CD (optional) ──────────────────────────────────────────────────────────
# GitHub PAT with read:packages scope — used by the deploy job to pull from GHCR
GHCR_TOKEN=

# ── Container ─────────────────────────────────────────────────────────────────
# Timezone for the app container and scheduler
TZ=UTC
