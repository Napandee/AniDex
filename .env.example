# Copy to .env and fill in values — never commit .env

# ── Database ──────────────────────────────────────────────────────────────────
# Full Postgres connection string
DATABASE_URL=postgresql://anime_tracker:changeme@localhost:5432/anime_tracker

# ── AniList ───────────────────────────────────────────────────────────────────
# Your AniList username (not email) — used to fetch your library
ANILIST_USERNAME=

# OAuth access token — needed for write operations (rating, status, progress)
# See README for how to obtain this via the AniList OAuth PIN flow
ANILIST_TOKEN=

# ── Crunchyroll (optional) ────────────────────────────────────────────────────
# Session cookie value. Log into crunchyroll.com in a browser, open DevTools ->
# Application -> Cookies -> https://www.crunchyroll.com, and copy the value of the
# etp_rt cookie. Long-lived but will eventually expire; update when CR sync starts failing.
CRUNCHYROLL_ETP_RT=

# ── Netflix (optional) ────────────────────────────────────────────────────────
# Full "cookie" request header value (not just NetflixId/SecureNetflixId — the
# viewing-activity API checks several other session cookies too) and the profile
# guid, both from devtools on a logged-in session. See
# scripts/dev/setup-netflix-env.sh for exactly where to find each in devtools.
NETFLIX_COOKIE_HEADER=
NETFLIX_PROFILE_GUID=

# ── Telegram notifications (optional) ────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal chat ID — get it from @userinfobot
TELEGRAM_CHAT_ID=

# Discord webhook and ntfy notifications are configured entirely in Settings ->
# Notifications after first launch — there's no .env equivalent for those two.

# ── Auth (multi-user) ────────────────────────────────────────────────────────
# Random secret used to sign session cookies. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random one is generated at startup — fine for local dev, but sessions
# won't survive a restart. Set a stable value for any real deployment.
SESSION_SECRET_KEY=

# Fernet key used to encrypt AniList/Crunchyroll/Netflix credentials and the TOTP
# 2FA secret at rest in the database (issue #310). Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED — unlike SESSION_SECRET_KEY, there is no random fallback: the app fails
# to start without this, because a key that changes on every restart would make
# already-encrypted data permanently unreadable. Set a stable value and keep it
# somewhere durable (Vaultwarden, etc.) — losing it makes existing encrypted
# credentials unrecoverable, same as losing a password manager's master key.
SETTINGS_ENCRYPTION_KEY=

# Google OAuth client — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth client — create at https://discord.com/developers/applications
# Redirect URI: https://your-domain/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── CI/CD (optional) ──────────────────────────────────────────────────────────
# GitHub PAT with read:packages scope — used by the deploy job to pull from GHCR
GHCR_TOKEN=

# ── Container ─────────────────────────────────────────────────────────────────
# Timezone for the app container and scheduler
TZ=UTC
