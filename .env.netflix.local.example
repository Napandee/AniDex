# Copy to .env.netflix.local (gitignored) and fill in — used by scripts/dev/probe-netflix.sh
# and scripts/dev/dryrun-netflix.sh. Never paste these values anywhere else (chat, an
# assistant session, a command line that gets logged) — they're live Netflix session
# credentials. Get them from a logged-in browser: devtools -> Application/Storage ->
# Cookies -> https://www.netflix.com -> copy the Value column for NetflixId and
# SecureNetflixId.
NETFLIX_ID_COOKIE=
NETFLIX_SECURE_ID_COOKIE=

# Used by scripts/dev/probe-netflix-falcor.sh (the Falcor pathEvaluator API probe).
# Find both on the pathEvaluator/viewingActivity request in devtools: the full
# "cookie" row under Request Headers, and the {"guid": "..."} value from the
# request body.
NETFLIX_COOKIE_HEADER=
NETFLIX_PROFILE_GUID=

# Optional — only needed for dryrun-netflix.sh to match against your real AniList
# library instead of the image's dummy placeholder.
ANILIST_TOKEN=
ANILIST_USERNAME=
