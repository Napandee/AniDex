FROM python:3.11-slim
WORKDIR /crunchyexporter

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# Fetch crunchyexporter-cli — pinned to a known-good commit; update deliberately
RUN git clone https://github.com/ruflas/crunchyexporter-cli.git . && git checkout 1855e56
RUN pip install --no-cache-dir requests click pyyaml rich

# Our sync script and its deps
COPY requirements-crunchysync.txt /tmp/requirements-crunchysync.txt
RUN pip install --no-cache-dir -r /tmp/requirements-crunchysync.txt
COPY scripts/sync_crunchyroll.py /app/scripts/sync_crunchyroll.py
COPY scripts/sync_anilist.py /app/scripts/sync_anilist.py
COPY scripts/run_recommender.py /app/scripts/run_recommender.py

COPY scripts/crunchysync-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["/entrypoint.sh"]
