__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
.pytest_cache/

# Secrets — never commit
.env
.env.*.local

# Local Claude Code context and machine-specific settings
.claude/settings.local.json
CLAUDE.local.md

# Private Claude context: symlink to the claude-context repo. NO TRAILING
# SLASH -- '.claude/context/' matches a directory only, and git treats a
# symlink as a file, so the slash form silently stops matching.
.claude/context

# Working scratch files -- never publish.
.claude/scratch/

# Compose data directories
compose/postgres-data/

# Per-checkout dev stack project name (scripts/dev/up.sh / down.sh)
.dev-stack-project

# Pre-migration pg_dump backups written by scripts/mark_migration_applied.sh (#469)
migration_backups/
